# Local ngrok agent settings. Copy this file to .env.ngrok and keep it untracked.
#
# Sign in with Google or email at https://dashboard.ngrok.com/signup, then copy
# the token from https://dashboard.ngrok.com/get-started/your-authtoken.
NGROK_AUTHTOKEN=

# Optional: reserve a static ngrok domain or use a custom domain you CNAME to
# ngrok. Leave blank for a random ngrok-free.app URL.
# Examples:
# NGROK_URL=https://example.ngrok-free.app
# NGROK_URL=https://form14.example.com
NGROK_URL=

# Optional comma-separated Cloudflare CNAME hostnames that should be accepted by
# Flask when Cloudflare points them at the ngrok endpoint.
NGROK_CLOUDFLARE_HOSTS=

# The launcher writes the discovered ngrok hostname here after the tunnel starts.
NGROK_ALLOWED_HOSTS=

# Docker-network upstream and local inspector bind.
NGROK_UPSTREAM=https://web:8000
NGROK_INSPECTOR_HOST=127.0.0.1
NGROK_INSPECTOR_PORT=4040
