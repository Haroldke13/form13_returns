APP_ENV=production
FLASK_APP=app.py
APP_TIMEZONE=Africa/Nairobi
PREFERRED_URL_SCHEME=https
PUBLIC_BASE_URL=auto
ALLOWED_HOSTS=auto,localhost,127.0.0.1
SECRET_KEY=change-this-to-a-long-random-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

PBORA_RUNTIME_ENV_AUTO_UPDATE=1
PBORA_NETWORK_INTERFACE=auto
PBORA_APP_HOST_IP=auto
PBORA_GATEWAY=auto
PBORA_ROUTE_PREFIX=19
PBORA_ROUTE_CIDR=10.107.0.0/19
PBORA_ASSIGN_HOST_IP=0
PBORA_REPLACE_LAN_ROUTE=1
PBORA_REPLACE_DEFAULT_ROUTE=1
PBORA_ROUTE_DRY_RUN=0
PBORA_POSTGRES_HOST=127.0.0.1
PBORA_POSTGRES_PORT=5432
PBORA_DATABASE_URL=postgresql+psycopg2://pbora:pbora@host.docker.internal:5432/pbora
INTERNAL_DATABASE_URL=postgresql+psycopg2://pbora:pbora@host.docker.internal:5432/pbora
DATABASE_URL=postgresql+psycopg2://pbora:pbora@host.docker.internal:5432/pbora
DATABASE_DIALECT=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pbora
DB_USER=pbora
DB_PASSWORD=pbora
DB_SSL_MODE=disable
SQLALCHEMY_CONNECT_TIMEOUT=5
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pbora
POSTGRES_USER=pbora
POSTGRES_PASSWORD=pbora
POSTGRES_SSL_MODE=disable
EXTERNAL_POSTGRES=1
RUN_SCHEMA_SYNC_ON_STARTUP=1
WEB_CONCURRENCY=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=360
FORM14_CONFIG_DIR=/app/instance/secure-config
FORM14_ARCHIVE_DIR=/app/instance/restricted
SQLITE_BOOTSTRAP_SOURCE_URL=sqlite:////app/instance/restricted/returnsform14_org_backup.sqlite

PERSISTENT_STORAGE_ROOT=/app/instance
UPLOAD_FOLDER=/app/instance/uploads
REPORT_MERGE_EXPORT_DIR=/app/instance/report_merge_exports
REPORT_MERGE_TEMP_DIR=/app/instance/report_merge_temp
DB_BACKUP_DIR=/app/instance/backups

SEED_USERS_ON_STARTUP=0
USER_SEED_RESET=0
USER_SEED_PASSWORD_DEFAULT=field.12345
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=field.12345

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_REDIRECT_URI_FALLBACK=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ENABLED=
GOOGLE_APPLICATION_CREDENTIALS=/app/instance/secure-config/application_default_credentials.json
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=

OPENAI_API_KEY=
