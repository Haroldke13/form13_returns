APP_ENV=production
APP_HOST=0.0.0.0
FLASK_DEBUG=0
FLASK_RUN_HOST=0.0.0.0
PORT=8000
HOST_PORT=8000
DOCKER_BIND_IP=0.0.0.0
PUBLIC_BASE_URL=auto
CANONICAL_HOSTNAME=returnsform13.org
FORCE_CANONICAL_HOST=0
ALLOWED_HOSTS=auto,localhost,127.0.0.1,returnsform13.org
SECRET_KEY=change-this-to-a-long-random-secret
SESSION_COOKIE_SECURE=true
CANONICAL_HOSTNAME=returnsform13.org
FORCE_CANONICAL_HOST=0

# Point these at a host disk that already has about 500GB free.
FORM14_INSTANCE_DIR=/mnt/form14-data/instance
FORM14_BACKUP_DIR=/mnt/form14-data/backups
FORM14_POSTGRES_DATA_DIR=/mnt/form14-data/postgres-data
FORM14_CONFIG_DIR=/mnt/form14-data/secure-config
FORM14_ARCHIVE_DIR=/mnt/form14-data/restricted

PBORA_RUNTIME_ENV_AUTO_UPDATE=1
PBORA_NETWORK_INTERFACE=auto
PBORA_APP_HOST_IP=auto
PBORA_GATEWAY=auto
PBORA_ROUTE_PREFIX=19
PBORA_ROUTE_CIDR=10.107.0.0/19
PBORA_ASSIGN_HOST_IP=0
PBORA_REPLACE_LAN_ROUTE=1
PBORA_REPLACE_DEFAULT_ROUTE=1
PBORA_ROUTE_DRY_RUN=0
PBORA_POSTGRES_HOST=127.0.0.1
PBORA_POSTGRES_PORT=5432
PBORA_DATABASE_URL=postgresql+psycopg2://pbora:pbora@host.docker.internal:5432/pbora
DATABASE_DIALECT=postgresql
INTERNAL_DATABASE_URL=postgresql+psycopg2://pbora:pbora@host.docker.internal:5432/pbora
DATABASE_URL=postgresql+psycopg2://pbora:pbora@host.docker.internal:5432/pbora
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pbora
DB_USER=pbora
DB_PASSWORD=pbora
DB_SSL_MODE=disable
SQLALCHEMY_CONNECT_TIMEOUT=5
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pbora
POSTGRES_USER=pbora
POSTGRES_PASSWORD=pbora
POSTGRES_SSL_MODE=disable
EXTERNAL_POSTGRES=1
WEB_CONCURRENCY=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=360

RUN_SCHEMA_SYNC_ON_STARTUP=1
RUN_SQLITE_TO_POSTGRES_IMPORT_ON_STARTUP=1
SQLITE_BOOTSTRAP_SOURCE_URL=sqlite:////mnt/form14-data/restricted/returnsform14_org_backup.sqlite
SEED_USERS_ON_STARTUP=0
USER_SEED_PASSWORD_DEFAULT=field.12345

GOOGLE_APPLICATION_CREDENTIALS=/mnt/form14-data/secure-config/application_default_credentials.json
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET_FILE=/mnt/form14-data/secure-config/client_secret_google_drive.json
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
GOOGLE_OAUTH_REDIRECT_URI_FALLBACK=https://your-domain-or-server-ip/auth/google/callback

ADMIN_USER_EMAIL=admin@example.local
ADMIN_USER_PASSWORD=field.12345
